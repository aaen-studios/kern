{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kern setup",
  "version": "0.1.0",
  "identifier": "com.ellio.kern.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "kern setup",
        "width": 620,
        "height": 520,
        "resizable": false,
        "center": true,
        "maximizable": false,
        "minimizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../src-tauri/icons/icon.ico"]
  }
}
