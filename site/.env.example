# ── Site URL (used for OAuth redirects, sitemap, metadata) ─
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Supabase (free tier) ──────────────────────────
# Create a project at https://supabase.com, then grab these from Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side only. Used by scripts/publish-plugins.mjs to upload .kern
# packages + version rows (bypasses RLS). NEVER expose or commit this key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Resend (free tier: 100 emails/day) ────────────
# Used for plugin report notifications. Create API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
# The email address where plugin reports are sent
REPORT_EMAIL=you@example.com

# ── GitHub (for rate-limit bump, optional) ────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
