{
  "name": "kern",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "remote:dev": "vite --config vite.remote.config.ts",
    "remote:build": "vite build --config vite.remote.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "e2e:stop": "bun scripts/e2e-stop.mjs",
    "e2e:cli": "bun scripts/e2e-cli.mjs",
    "plugins:pack": "node scripts/pack-plugins.mjs",
    "plugins:build": "npm --prefix plugins/minecraft_java run build && npm --prefix plugins/discord_bot run build",
    "plugins:check": "bun scripts/plugins-check.mjs",
    "plugins:bundle": "node scripts/plugin-upload-bundle.mjs",
    "installer:build": "node scripts/build-installer.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "installer:assets": "node scripts/make-installer-assets.mjs && node scripts/make-installer-skin.mjs",
    "installer:skin": "node scripts/make-installer-skin.mjs",
    "installer:prepare": "node scripts/prepare-nsis.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
